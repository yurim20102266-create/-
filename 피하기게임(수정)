"use strict";

(() => {
  const player = document.getElementById("player");
  const game = document.getElementById("game");
  const startBtn = document.getElementById("startBtn");
  const pauseBtn = document.getElementById("pauseBtn");
  const status = document.getElementById("status");
  const effectBtn = document.getElementById("effectBtn");

  const $ = (id) => document.getElementById(id);

  let effectEnabled = !matchMedia(
    "(prefers-reduced-motion: reduce)"
  ).matches;

  let playerX = 280;
  let obstacles = [];

  let gameRunning = false;
  let paused = false;

  let gameStartTime = 0;
  let pausedTime = 0;
  let pauseStartedAt = 0;

  let gameTimer = null;
  let spawnTimer = null;
  let moveTimer = null;
  let screenShake = null;

  const GAME_TIME = 30000;
  const SPAWN_INTERVAL = 900;
  const BEST_TIME_KEY = "avoid30_best_time";

  let bestTime = loadBestTime();

  function loadBestTime() {
    try {
      const saved = localStorage.getItem(BEST_TIME_KEY);

      if (saved === null) {
        return 0;
      }

      const value = Number(saved);

      if (
        !Number.isFinite(value) ||
        value < 0 ||
        value > GAME_TIME / 1000
      ) {
        return 0;
      }

      return value;
    } catch {
      return 0;
    }
  }

  function saveBestTime(time) {
    if (time > bestTime) {
      bestTime = time;

      try {
        localStorage.setItem(
          BEST_TIME_KEY,
          String(bestTime)
        );
      } catch {
        $("storageNotice").textContent =
          "저장 공간을 사용할 수 없어 이번 방문 동안만 기록됩니다.";
      }
    }

    $("best").textContent =
      bestTime.toFixed(1) + " 초";
  }

  function clearTimers() {
    clearInterval(gameTimer);
    clearInterval(spawnTimer);
    clearInterval(moveTimer);
  }

  function stopEffect() {
    if (screenShake) {
      screenShake.cancel();
      screenShake = null;
    }
  }

  function updateEffect() {
    effectBtn.textContent = effectEnabled
      ? "효과 ON"
      : "효과 OFF";

    effectBtn.setAttribute(
      "aria-pressed",
      String(effectEnabled)
    );

    if (!effectEnabled) {
      stopEffect();
    }
  }

  startBtn.addEventListener("click", () => {
    if (paused) {
      togglePause();
    } else {
      startGame();
    }
  });

  pauseBtn.addEventListener(
    "click",
    togglePause
  );

  effectBtn.addEventListener("click", () => {
    effectEnabled = !effectEnabled;
    updateEffect();
  });

  function movePlayer(direction) {
    if (!gameRunning || paused) {
      return;
    }

    playerX = Math.max(
      0,
      Math.min(
        560,
        playerX + direction * 25
      )
    );

    player.style.left = playerX + "px";
  }

  document.addEventListener("keydown", (event) => {
    if (
      ["INPUT", "TEXTAREA", "SELECT"].includes(
        event.target.tagName
      ) ||
      event.target.isContentEditable
    ) {
      return;
    }

    const key = event.key.toLowerCase();

    if (
      ![
        "r",
        "p",
        "a",
        "d",
        "arrowleft",
        "arrowright"
      ].includes(key)
    ) {
      return;
    }

    event.preventDefault();

    if (key === "r") {
      if (!event.repeat) {
        startGame();
      }

      return;
    }

    if (key === "p") {
      if (!event.repeat) {
        togglePause();
      }

      return;
    }

    if (
      key === "arrowleft" ||
      key === "a"
    ) {
      movePlayer(-1);
    }

    if (
      key === "arrowright" ||
      key === "d"
    ) {
      movePlayer(1);
    }
  });

  $("leftBtn").addEventListener("click", () => {
    movePlayer(-1);
  });

  $("rightBtn").addEventListener("click", () => {
    movePlayer(1);
  });

  function startGame() {
    clearTimers();
    stopEffect();

    obstacles.forEach((obstacle) => {
      obstacle.element.remove();
    });

    obstacles = [];

    playerX = 280;
    player.style.left = playerX + "px";

    gameRunning = true;
    paused = false;

    gameStartTime = performance.now();
    pausedTime = 0;
    pauseStartedAt = 0;

    pauseBtn.textContent = "일시정지";
    pauseBtn.disabled = false;

    status.textContent =
      "게임 중! 빨간 장애물을 피하세요!";

    $("stateLabel").textContent = "PLAYING";
    $("overlay").hidden = true;
    $("timeDisplay").textContent = "30.0 SEC";
    $("progress").style.width = "0%";

    spawnTimer = setInterval(
      createObstacle,
      SPAWN_INTERVAL
    );

    moveTimer = setInterval(
      moveObstacles,
      20
    );

    gameTimer = setInterval(
      updateTime,
      100
    );
  }

  function elapsedTime() {
    return Math.max(
      0,
      (paused ? pauseStartedAt : performance.now()) -
        gameStartTime -
        pausedTime
    );
  }

  function updateTime() {
    if (!gameRunning || paused) {
      return;
    }

    const elapsed = elapsedTime();

    status.textContent =
      "남은 시간: " +
      Math.max(
        0,
        Math.ceil(
          (GAME_TIME - elapsed) / 1000
        )
      ) +
      "초";

    $("timeDisplay").textContent =
      Math.max(
        0,
        (GAME_TIME - elapsed) / 1000
      ).toFixed(1) +
      " SEC";

    $("progress").style.width =
      Math.min(
        100,
        (elapsed / GAME_TIME) * 100
      ) +
      "%";

    if (elapsed >= GAME_TIME) {
      winGame();
    }
  }

  function togglePause() {
    if (!gameRunning) {
      return;
    }

    if (!paused) {
      if (elapsedTime() >= GAME_TIME) {
        winGame();
        return;
      }

      paused = true;
      pauseStartedAt = performance.now();

      pauseBtn.textContent = "계속하기";
      status.textContent = "⏸ 일시정지 중";
      $("stateLabel").textContent = "PAUSED";

      showOverlay(
        "잠깐, 숨 고르기",
        "준비되면 멈춘 자리에서 이어가세요.",
        "계속하기 ▶"
      );
    } else {
      pausedTime +=
        performance.now() - pauseStartedAt;

      paused = false;

      pauseBtn.textContent = "일시정지";
      status.textContent = "게임 계속!";
      $("stateLabel").textContent = "PLAYING";
      $("overlay").hidden = true;
    }
  }

  function createObstacle() {
    if (!gameRunning || paused) {
      return;
    }

    const obstacle =
      document.createElement("div");

    obstacle.className = "obstacle";

    const x = Math.floor(
      Math.random() * 560
    );

    obstacle.style.left = x + "px";
    obstacle.style.top = "0px";

    game.appendChild(obstacle);

    obstacles.push({
      element: obstacle,
      x: x,
      y: 0
    });
  }

  function moveObstacles() {
    if (!gameRunning || paused) {
      return;
    }

    if (elapsedTime() >= GAME_TIME) {
      winGame();
      return;
    }

    for (
      let i = obstacles.length - 1;
      i >= 0;
      i--
    ) {
      const obstacle = obstacles[i];

      obstacle.y += 4;

      obstacle.element.style.top =
        obstacle.y + "px";

      if (checkCollision(obstacle)) {
        loseGame();
        return;
      }

      if (obstacle.y > 400) {
        obstacle.element.remove();
        obstacles.splice(i, 1);
      }
    }
  }

  function checkCollision(obstacle) {
    return (
      playerX < obstacle.x + 40 &&
      playerX + 40 > obstacle.x &&
      340 < obstacle.y + 40 &&
      380 > obstacle.y
    );
  }

  function showOverlay(title, text, button) {
    $("overlayTitle").textContent = title;
    $("overlayText").textContent = text;

    $("overlayEyebrow").textContent =
      $("stateLabel").textContent;

    startBtn.textContent = button;
    $("overlay").hidden = false;
  }

  function finish(won) {
    if (!gameRunning) {
      return;
    }

    const survivalTime = won
      ? 30
      : Math.min(
          30,
          elapsedTime() / 1000
        );

    saveBestTime(survivalTime);

    gameRunning = false;
    paused = false;

    clearTimers();

    pauseBtn.disabled = true;
    pauseBtn.textContent = "일시정지";

    $("stateLabel").textContent = won
      ? "CLEAR"
      : "GAME OVER";

    $("timeDisplay").textContent =
      (30 - survivalTime).toFixed(1) +
      " SEC";

    $("progress").style.width =
      (survivalTime / 30) * 100 +
      "%";

    status.textContent =
      (
        won
          ? "🎉 성공! 30초 생존!"
          : "💥 실패! " +
            survivalTime.toFixed(1) +
            "초 생존!"
      ) +
      " / R로 다시 시작";

    showOverlay(
      won
        ? "30초, 끝까지 살아남았다!"
        : "다시 한 번 피해볼까요?",

      survivalTime.toFixed(1) +
        "초 생존 · 최고 기록 " +
        bestTime.toFixed(1) +
        "초",

      "다시 시작 ↻"
    );

    if (!won && effectEnabled) {
      stopEffect();

      screenShake = document.body.animate(
        [
          {
            transform: "translate(0, 0)"
          },
          {
            transform: "translate(-24px, 12px)"
          },
          {
            transform: "translate(24px, -12px)"
          },
          {
            transform: "translate(-21px, -10px)"
          },
          {
            transform: "translate(20px, 10px)"
          },
          {
            transform: "translate(-16px, 8px)"
          },
          {
            transform: "translate(14px, -7px)"
          },
          {
            transform: "translate(-10px, -5px)"
          },
          {
            transform: "translate(8px, 4px)"
          },
          {
            transform: "translate(-4px, -2px)"
          },
          {
            transform: "translate(0, 0)"
          }
        ],
        {
          duration: 650,
          easing: "linear",
          iterations: 1
        }
      );

      screenShake.onfinish = () => {
        screenShake = null;
      };
    }
  }

  function winGame() {
    finish(true);
  }

  function loseGame() {
    finish(false);
  }

  window.addEventListener("blur", () => {
    if (gameRunning && !paused) {
      togglePause();
    }
  });

  document.addEventListener(
    "visibilitychange",
    () => {
      if (
        document.hidden &&
        gameRunning &&
        !paused
      ) {
        togglePause();
      }
    }
  );

  function resizeGame() {
    const scale =
      $("viewport").clientWidth / 600;

    $("scaled").style.transform =
      "scale(" + scale + ")";

    $("viewport").style.height =
      400 * scale + "px";
  }

  window.addEventListener(
    "resize",
    resizeGame
  );

  resizeGame();
  updateEffect();

  $("best").textContent =
    bestTime.toFixed(1) + " 초";

  if (document.modelContext?.registerTool) {
    try {
      Promise.resolve(
        document.modelContext.registerTool({
          name: "read_avoid_game",

          description:
            "Read the current survival game state and best time.",

          inputSchema: {
            type: "object",
            properties: {},
            additionalProperties: false
          },

          annotations: {
            readOnlyHint: true
          },

          execute: (input) => {
            if (
              !input ||
              typeof input !== "object" ||
              Array.isArray(input) ||
              Object.keys(input).length
            ) {
              throw Error(
                "Expected an empty object"
              );
            }

            return {
              gameRunning,
              paused,
              playerX,
              bestTime
            };
          }
        })
      ).catch(() => {});
    } catch {}
  }
})();
